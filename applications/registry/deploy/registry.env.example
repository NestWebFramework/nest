# /etc/nest/registry.env — the Nest registry's environment (secrets live here, never in git).
# Readable by root only:  sudo install -m 0600 registry.env.example /etc/nest/registry.env

# --- the site -------------------------------------------------------------------------------
# openssl rand -hex 32 (one KEY=VALUE per line, nothing after the value)
NEST_SECRET_KEY=change-me-to-64-random-characters
NEST_ALLOWED_HOSTS=registry.nest-framework.org
# nginx on the host forwards from the docker bridge; the port is bound to 127.0.0.1 only,
# so only nginx can reach it: its X-Forwarded-* headers are believed
NEST_TRUSTED_PROXIES=*
NEST_WORKERS=2
NEST_THREADS=8

# --- who may publish (the registry's settings; also editable in its admin panel) -----------
NEST_REGISTRY_APP__REGISTRY__PUBLISHERS=approved
# NEST_REGISTRY_APP__REGISTRY__REQUIRE_SIGNATURES=true

# --- the database: SQLite in /data unless PostgreSQL is chosen -----------------------------
# NEST_BIND__NEST_DB=db-postgres
# NEST_REGISTRY_APP__DB_POSTGRES__URL=postgresql://registry:secret@db.lan:5432/registry

# --- the files: /data/media unless S3/MinIO is chosen ---------------------------------------
# NEST_BIND__NEST_STORAGE=storage-s3
# NEST_REGISTRY_APP__STORAGE_S3__ENDPOINT=minio.lan:9000
# NEST_REGISTRY_APP__STORAGE_S3__BUCKET=nest-registry
# NEST_REGISTRY_APP__STORAGE_S3__ACCESS_KEY=...
# NEST_REGISTRY_APP__STORAGE_S3__SECRET_KEY=...
