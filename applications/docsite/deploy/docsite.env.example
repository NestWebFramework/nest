# /etc/nest/docsite.env: nest-framework.org's secrets and production settings (never in git).
NEST_SECRET_KEY=change-me                       # openssl rand -hex 32 (nest-site init writes one)
NEST_ALLOWED_HOSTS=nest-framework.org,www.nest-framework.org
NEST_TRUSTED_PROXIES=*
NEST_WORKERS=2
NEST_THREADS=8

# --- the keeper's agent (at /_agent) -------------------------------------------------------------
# Make the tokens on any machine with Nest: nest agent token docsite (reads) and
# nest agent token docsite --control (also runs its actions: a backup, ...). Each prints a token
# for the keeper's "Watch a site" page and the line to put here (only a SHA-256 is kept here).
# NEST_DOCSITE__AGENT__READ_TOKEN=sha256:...
# NEST_DOCSITE__AGENT__CONTROL_TOKEN=sha256:...
