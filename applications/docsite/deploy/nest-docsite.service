# nest-framework.org (Nest's documentation site), as a container from Docker Hub (as the
# Nest registry runs).
#
# Its data (the search index, settings, accounts, and the .env with NEST_SECRET_KEY) are the
# folder DATA on this server (Docker from the snap: under /var/snap/docker/common), mounted
# at /data: they stay through restarts and new images. The pages themselves are in the
# image. The container runs as that folder's owner, so it can write there.
#
#   sudo install -m 0644 nest-docsite.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now nest-docsite

[Unit]
Description=nest-framework.org (Nest)
Wants=network-online.target
After=network-online.target snap.docker.dockerd.service
Requires=snap.docker.dockerd.service

[Service]
Type=simple
# its data: under /var/snap/docker/common, the folders the docker snap may mount
Environment=DATA=/var/snap/docker/common/nest/docsite
Environment=IMAGE=miraur/nest-docsite:latest

ExecStartPre=-/snap/bin/docker pull ${IMAGE}
ExecStartPre=-/snap/bin/docker rm -f nest-docsite
ExecStart=/bin/sh -c 'exec /snap/bin/docker run --rm --name nest-docsite \
    --user "$$(stat -c %%u:%%g ${DATA})" -e HOME=/data \
    -e NEST_ALLOWED_HOSTS=nest-framework.org,www.nest-framework.org -e "NEST_TRUSTED_PROXIES=*" -e NEST_WORKERS=2 \
    -v ${DATA}:/data -p 127.0.0.1:8700:8000 --memory 512m \
    --log-driver json-file --log-opt max-size=10m --log-opt max-file=3 \
    ${IMAGE}'
ExecStop=/snap/bin/docker stop -t 30 nest-docsite

Restart=on-failure
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
