# /etc/nest/keeper.env: the keeper's secrets and production settings (never in git).
#   sudo install -m 0600 keeper.env.example /etc/nest/keeper.env
# One KEY=VALUE per line, nothing after the value: docker --env-file takes the rest of
# the line as the value, a comment with it.

# NEST_SECRET_KEY also makes the key the agents' tokens are kept encrypted with: if it
# changes, the keeper asks for every site's token again.
NEST_SECRET_KEY=change-me
NEST_ALLOWED_HOSTS=keeper.example.org
NEST_TRUSTED_PROXIES=*
# one worker is plenty: one person reads it, and one worker checks the sites
NEST_WORKERS=1
NEST_THREADS=8
NEST_LOG_LEVEL=info

# the keeper runs in a container: its "Applications" page has no application folders to read
NEST_KEEPER__KEEPER__APPS=

# how often each site is checked, and how long the checks are kept
# NEST_KEEPER__KEEPER__CHECK_SECONDS=60
# NEST_KEEPER__KEEPER__HISTORY_DAYS=30

# --- restarts and upgrades from the keeper: the host helper (nest-host) ------------------------
# On the host: sudo nest-host token. Its token goes here, its TOKEN_SHA256 line into
# /etc/nest/host.conf, which has BIND=172.17.0.1 (the Docker bridge, where this container
# reaches the host).
# NEST_KEEPER__KEEPER__HOST_URL=http://172.17.0.1:8090
# NEST_KEEPER__KEEPER__HOST_TOKEN=nh_...
