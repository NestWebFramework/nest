# The keeper (one person's: it watches your deployed sites), as a container from Docker Hub
# (as the Nest registry runs).
#
# Its data (the watched sites, their checks, the actions' log, its accounts, and the .env
# with NEST_SECRET_KEY) are the folder DATA on this server (Docker from the snap: under
# /var/snap/docker/common), mounted at /data: they stay through restarts and new images.
# The container runs as that folder's owner, so it can write there. It reaches the sites at
# their public addresses (https://gari.ro/_agent).
#
#   sudo install -m 0644 nest-keeper.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now nest-keeper

[Unit]
Description=Nest keeper
Wants=network-online.target
After=network-online.target snap.docker.dockerd.service
Requires=snap.docker.dockerd.service

[Service]
Type=simple
# its data: under /var/snap/docker/common, the folders the docker snap may mount
Environment=DATA=/var/snap/docker/common/nest/keeper
Environment=IMAGE=miraur/nest-keeper:latest

ExecStartPre=-/snap/bin/docker pull ${IMAGE}
ExecStartPre=-/snap/bin/docker rm -f nest-keeper
ExecStart=/bin/sh -c 'exec /snap/bin/docker run --rm --name nest-keeper \
    --user "$$(stat -c %%u:%%g ${DATA})" -e HOME=/data \
    -e NEST_ALLOWED_HOSTS=keeper.example.org -e "NEST_TRUSTED_PROXIES=*" -e NEST_WORKERS=1 \
    -e NEST_KEEPER__KEEPER__APPS= \
    -v ${DATA}:/data -p 127.0.0.1:8800:8000 --memory 384m \
    --log-driver json-file --log-opt max-size=10m --log-opt max-file=3 \
    ${IMAGE}'
ExecStop=/snap/bin/docker stop -t 30 nest-keeper

Restart=on-failure
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
