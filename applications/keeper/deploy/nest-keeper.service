# systemd unit for the keeper, run as a container (as the Nest registry runs).
#
# systemd pulls the image, runs the container in the foreground and restarts it; the
# container has no restart policy of its own (one supervisor, not two). Its data are a
# folder on the host, /srv/nest/keeper, mounted at /data: databases, uploaded files,
# settings, backups. The container is thrown away at each stop; the folder stays, through
# restarts, new images and rollbacks. The port is bound to the loopback: nginx (ISPConfig's
# vhost) is what faces the network.
#
#   sudo install -m 0644 nest-keeper.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now nest-keeper

[Unit]
Description=the keeper (Nest)
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
ConditionPathIsDirectory=/srv/nest/keeper

[Service]
Type=simple
# a version instead of latest pins it (0.2.0), or goes back to it
Environment=IMAGE=miraur/nest-keeper:latest

# the cached image when the pull fails, so a host without network at boot still starts
ExecStartPre=-/usr/bin/docker pull ${IMAGE}
ExecStartPre=-/usr/bin/docker rm -f nest-keeper
ExecStart=/usr/bin/docker run --rm --name nest-keeper \
    --env-file /etc/nest/keeper.env \
    -v /srv/nest/keeper:/data \
    -p 127.0.0.1:8800:8000 \
    --memory 384m \
    --log-driver json-file --log-opt max-size=10m --log-opt max-file=3 \
    ${IMAGE}
ExecStop=/usr/bin/docker stop -t 30 nest-keeper

Restart=on-failure
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
