# nest-host: the keeper's hands on the server: restart, back up, upgrade, roll back the
# sites nest-site runs, when the keeper asks with its token (see nest-host's own help).
#
#   sudo install -m 0755 nest-host /usr/local/bin/
#   sudo nest-host token          # the keeper's token, and the line for /etc/nest/host.conf
#   sudo install -m 0644 nest-host.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now nest-host

[Unit]
Description=Nest host helper (the keeper's restarts, backups and upgrades, through nest-site)
Documentation=https://nest-framework.org/docs/operate/keeper
After=network-online.target docker.service
Wants=network-online.target
ConditionPathExists=/etc/nest/host.conf

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I /usr/local/bin/nest-host serve
Restart=on-failure
RestartSec=5
# it runs nest-site as root (systemctl, docker); everything else it may not touch
NoNewPrivileges=yes
PrivateTmp=yes
# git pull (nest-site upgrade) reads root's deploy key in /root/.ssh
ProtectHome=read-only
ProtectSystem=full
ReadWritePaths=-/var/lib/nest-site -/srv/nest -/opt/nest -/root/.docker
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
