#!/bin/sh
# nest-secret-key: give each site's data folder its NEST_SECRET_KEY, in the folder's .env.
#
#   sudo nest-secret-key /srv/nest/gari /srv/nest/morlaca /srv/nest/transilpedia /srv/nest/regionalisme
#
# For each folder: if its .env already has NEST_SECRET_KEY, nothing changes. Otherwise the key
# the site already had (data/secret.key, from development: everyone stays signed in) is
# written to .env; without one, a new random key. The .env belongs to the folder's owner
# (the container runs as that user) and only that user may read it (600).
set -eu

[ $# -ge 1 ] || { sed -n '2,9p' "$0"; exit 1; }

for dir in "$@"; do
  dir=${dir%/}
  if [ ! -d "$dir" ]; then
    echo "✗ $dir: no such folder"; continue
  fi
  env="$dir/.env"
  if [ -f "$env" ] && grep -q '^NEST_SECRET_KEY=' "$env"; then
    echo "· $dir: already has NEST_SECRET_KEY"; continue
  fi
  if [ -s "$dir/data/secret.key" ]; then
    key=$(tr -d '\n' < "$dir/data/secret.key"); from="data/secret.key"
  else
    key=$(head -c 48 /dev/urandom | base64 | tr -d '\n/+=' | head -c 64); from="a new random key"
  fi
  [ ${#key} -ge 32 ] || { echo "✗ $dir: the key is too short"; continue; }
  # a newline first if the .env does not end with one
  if [ -s "$env" ] && [ "$(tail -c 1 "$env" | od -An -c | tr -d ' ')" != '\n' ]; then
    echo >> "$env"
  fi
  echo "NEST_SECRET_KEY=$key" >> "$env"
  chown "$(stat -c %u:%g "$dir")" "$env"
  chmod 600 "$env"
  echo "✓ $dir: NEST_SECRET_KEY set from $from (owner $(stat -c %U:%G "$dir"))"
done
